POSTGRES_DB=ai_agent_db
POSTGRES_USER=ai_agent
POSTGRES_PASSWORD=ai_agent_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://ai_agent:ai_agent_password@postgres:5432/ai_agent_db
REDIS_URL=redis://redis:6379
MOCK_API_URL=http://mock-api:8010
ENVIRONMENT=development
APP_TIMEZONE=Asia/Seoul

# OpenAI API 키 — LLM 응답 생성에 사용 (없으면 템플릿 모드로 동작)
OPENAI_API_KEY=

# OpenAI 모델명 (기본값: gpt-4o-mini)
# 변경 예: OPENAI_MODEL=gpt-4o
OPENAI_MODEL=gpt-4o-mini

# ── API Key 인증 설정 ──────────────────────────────────────
# AUTH_ENABLED=false : 개발 환경 — 인증 없이 전체 허용
# AUTH_ENABLED=true  : 운영 환경 — X-API-Key 헤더 필수
AUTH_ENABLED=false

# 역할별 API 키 (운영 시 openssl rand -hex 32 로 생성하여 설정)
# AUTH_ENABLED=false 이면 이 값은 사용되지 않는다
API_KEY_ADMIN=
API_KEY_ANALYST=
API_KEY_READONLY=

# Signed portal session settings
SESSION_SECRET=replace-with-a-long-random-secret
SESSION_TTL_SECONDS=1800
